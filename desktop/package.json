{
  "name": "rati-swarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RATi Swarm desktop app for Pulse, Radar, Flash, and local or cloud scanning.",
  "main": "src/main/main.cjs",
  "author": "RATi",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env RATI_DESKTOP_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && node --check src/main/main.cjs && node --check src/preload/preload.cjs && node --check forge.config.cjs",
    "test": "vitest run && node --test src/main/public-data.test.cjs",
    "package": "pnpm build && electron-forge package",
    "make": "pnpm build && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-deb": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/maker-zip": "8.0.0-alpha.10",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "44.0.0",
    "glob": "7.2.3",
    "jsdom": "30.0.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wait-on": "^9.0.1"
  },
  "pnpm": {
    "overrides": {
      "tar": "7.5.21",
      "tmp": "0.2.7"
    },
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "fs-xattr",
      "macos-alias"
    ]
  }
}
