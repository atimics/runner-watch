{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RATi Runners",
  "version": "0.1.0",
  "identifier": "chat.rati.swarm",
  "build": {
    "beforeDevCommand": "pnpm vite --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RATi Runners",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#07110d",
        "theme": "Dark",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Evidence-first market runner scanner",
    "longDescription": "RATi Runners combines built-in, RATi, and user-configured scanner sources in one local workspace.",
    "externalBin": [
      "binaries/rati-scanner"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
