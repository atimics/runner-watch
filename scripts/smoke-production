#!/bin/sh
set -eu

origin=${1:-https://stonks.rati.foundation}
attempts=${SMOKE_ATTEMPTS:-12}
delay_seconds=${SMOKE_DELAY_SECONDS:-10}

check_endpoint() {
    endpoint=$1
    attempt=1
    while [ "$attempt" -le "$attempts" ]; do
        if curl --fail --silent --show-error --location --max-time 20 \
            "${origin}${endpoint}" >/dev/null; then
            return 0
        fi
        attempt=$((attempt + 1))
        if [ "$attempt" -le "$attempts" ]; then
            sleep "$delay_seconds"
        fi
    done
    echo "Production check failed: ${origin}${endpoint}" >&2
    return 1
}

check_endpoint /live
check_endpoint /ready
check_endpoint /health
check_endpoint /
check_endpoint /login
check_endpoint /radar
check_endpoint '/api/pulse?limit=1'
check_endpoint '/api/radar?limit=1'
check_endpoint '/api/sports/pulse?limit=1'
