#!/bin/sh
set -eu

origin=${1:-https://runners.rati.chat}
attempts=${SMOKE_ATTEMPTS:-12}
delay_seconds=${SMOKE_DELAY_SECONDS:-10}

check_endpoint() {
    endpoint=$1
    attempt=1
    while [ "$attempt" -le "$attempts" ]; do
        if curl --fail --silent --show-error --location --max-time 20 \
            "${origin}${endpoint}" >/dev/null; then
            return 0
        fi
        attempt=$((attempt + 1))
        if [ "$attempt" -le "$attempts" ]; then
            sleep "$delay_seconds"
        fi
    done
    echo "Production check failed: ${origin}${endpoint}" >&2
    return 1
}

check_endpoint /live
check_endpoint /api/version
check_endpoint /ready
check_endpoint /health
check_endpoint /
check_endpoint /login
check_endpoint /radar
check_endpoint /reports
check_endpoint /memecoins
check_endpoint /memecoins/radar
check_endpoint /memecoins/alpha
check_endpoint /api/memecoins
check_endpoint /api/memecoin-calls
check_endpoint '/api/pulse?limit=1'
check_endpoint '/api/radar?limit=1'
check_endpoint '/api/sports/pulse?limit=1'

version_payload=$(curl --fail --silent --show-error --location --max-time 20 \
    "${origin}/api/version")
if ! deployed_build=$(printf '%s' "$version_payload" | python3 -c '
import json
import sys

payload = json.load(sys.stdin)
assert all(payload.get(key) for key in ("version", "build_sha", "static_version"))
print(payload["build_sha"])
'); then
    echo "Production version response is invalid: ${origin}/api/version" >&2
    exit 1
fi

if [ -n "${EXPECTED_BUILD_SHA:-}" ] && [ "$deployed_build" != "$EXPECTED_BUILD_SHA" ]; then
    echo "Production build mismatch: expected ${EXPECTED_BUILD_SHA}, got ${deployed_build}" >&2
    exit 1
fi
