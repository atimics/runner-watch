{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rati-products-router",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "secrets": {
    "required": ["EDGE_PROXY_SECRET"]
  },
  "routes": [
    {
      "pattern": "runners.rati.chat/*",
      "zone_name": "rati.chat"
    },
    {
      "pattern": "sports.rati.chat/*",
      "zone_name": "rati.chat"
    }
  ]
}
